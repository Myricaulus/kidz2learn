<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>69014,69654</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.22" />
    <PackageReference Include="MudBlazor" Version="8.14.0" />
    <PackageReference Include="Tavenem.Blazor.IndexedDB" Version="6.4.1" />
  </ItemGroup>

  <!-- Kidz2Learn.Tests lives in a subfolder of this project; without this, SDK-style
       implicit globbing would also compile its files (and its obj/ output) into this project. -->
  <ItemGroup>
    <Compile Remove="Kidz2Learn.Tests/**/*.cs" />
    <Content Remove="Kidz2Learn.Tests/**/*" />
    <None Remove="Kidz2Learn.Tests/**/*" />
  </ItemGroup>

  <!-- Regenerates the SID and audio-affirmation file manifests (wwwroot/sids/sidfiles.<hash>.json,
       wwwroot/audio/affirmations/affirmations.<hash>.json, their URLs in Shared/AssetManifests.g.cs)
       from whatever files are actually present in those folders, so dropping in a new file and
       rebuilding is enough - no manual regen step to forget. Needs python3 (standard library only,
       also present on Netlify's build image); a failure fails the build, so a stale manifest can't
       ship silently. Runs before compiling (the URLs are constants), and re-globs the manifests:
       the evaluation-time wwwroot glob still lists the deleted old version, not the new one. -->
  <Target Name="RegenerateAudioManifests" BeforeTargets="BeforeBuild">
    <Exec Command="python3 tools/generate_manifests.py"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <_DeletedManifest Include="@(Content)" Condition="!Exists('%(FullPath)')" />
      <Content Remove="@(_DeletedManifest)" />
      <Content Include="wwwroot/sids/sidfiles.*.json;wwwroot/audio/affirmations/affirmations.*.json"
               Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
