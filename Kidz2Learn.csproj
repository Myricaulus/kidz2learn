<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>69014,69654</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.22" />
    <PackageReference Include="MudBlazor" Version="8.14.0" />
    <PackageReference Include="Tavenem.Blazor.IndexedDB" Version="6.4.1" />
  </ItemGroup>

  <!-- Kidz2Learn.Tests lives in a subfolder of this project; without this, SDK-style
       implicit globbing would also compile its files (and its obj/ output) into this project. -->
  <ItemGroup>
    <Compile Remove="Kidz2Learn.Tests/**/*.cs" />
    <Content Remove="Kidz2Learn.Tests/**/*" />
    <None Remove="Kidz2Learn.Tests/**/*" />
  </ItemGroup>

  <!-- Regenerates the SID and audio-affirmation file manifests (wwwroot/sids/sidfiles.json,
       wwwroot/audio/affirmations/affirmations.json) from whatever files are actually present in
       those folders, so dropping in a new file and rebuilding is enough - no manual regen step
       to forget. Needs PowerShell Core (pwsh); ContinueOnError keeps the build working on
       machines/CI without it installed, just skipping the regen with a warning. -->
  <Target Name="RegenerateAudioManifests" BeforeTargets="Build">
    <Exec Command="pwsh -NoProfile -File generate_sid_json.ps.ps1"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="WarnAndContinue" />
    <Exec Command="pwsh -NoProfile -File generate_affirmations_json.ps1"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
