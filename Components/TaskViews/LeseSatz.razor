@using Kidz2Learn.Model.Lesen
@using Kidz2Learn.Services

@* A sentence in large reading type. Words from the known word list (WordMeta) can be tapped to
   hear them - a single-word lifeline, not a read-aloud of the whole sentence. Every tap goes into
   the next answer's Beobachtung: the words the child couldn't read alone. *@
<p class="lese-satz">
    @foreach (var token in _tokens)
    {
        var audio = token.Audio;
        <span class="lese-wort @(audio is not null ? "lese-wort-hoerbar" : "")"
              @onclick="() => Play(token.Text, audio)">@token.Text</span>
    }
</p>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    [Inject] private AudioStatusService Audio { get; set; } = null!;
    [Inject] private TaskSessionController Session { get; set; } = null!;

    private sealed record Token(string Text, string? Audio);

    private List<Token> _tokens = [];

    protected override void OnParametersSet()
    {
        _tokens = Text.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => new Token(word, WordAudio.PathFor(word)))
            .ToList();
    }

    private void Play(string wort, string? audio)
    {
        Session.NoteAngetippt(wort.Trim(',', '.', '!', '?', ':', ';'));
        if (audio is not null)
            _ = Audio.PlayWordAsync(audio);
    }
}
