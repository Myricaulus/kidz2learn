@using Kidz2Learn.Model.Lesen
@using Microsoft.JSInterop

@* A sentence in large reading type. Words from the known word list (WordMeta) can be tapped to
   hear them - a single-word lifeline, not a read-aloud of the whole sentence. *@
<p class="lese-satz">
    @foreach (var token in _tokens)
    {
        var audio = token.Audio;
        <span class="lese-wort @(audio is not null ? "lese-wort-hoerbar" : "")"
              @onclick="() => Play(audio)">@token.Text</span>
    }
</p>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    [Inject] private IJSRuntime Js { get; set; } = null!;

    private sealed record Token(string Text, string? Audio);

    private List<Token> _tokens = [];

    protected override void OnParametersSet()
    {
        _tokens = Text.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => new Token(word, WordAudio.PathFor(word)))
            .ToList();
    }

    private async Task Play(string? audio)
    {
        if (audio is not null)
            await Js.InvokeVoidAsync("k4l_playAudioFile", "audioPlayer", audio);
    }
}
