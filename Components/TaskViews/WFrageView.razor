<div class="lese-container">
    <LeseSatz Text="@_serie.Text" />

    <div class="lese-frage" style="border-color:@Farbe">
        @if (_serie.Fragen.Count > 1)
        {
            <div class="lese-frage-nummer">Frage @(_index + 1) von @_serie.Fragen.Count</div>
        }
        <h2 class="lese-frage-text">
            <span @key="_hinweisCount" class="lese-fragewort @(_hinweisCount > 0 ? "lese-fragewort-hinweis" : "")"
                  style="color:@Farbe">@Aufgabe.Fragewort.ToUpperInvariant()</span>@Aufgabe.Frage[Aufgabe.Fragewort.Length..]
        </h2>
    </div>

    <div class="lese-optionen">
        @foreach (var option in Aufgabe.Optionen)
        {
            <button class="lese-option @OptionClass(option)"
                    disabled="@(_isProcessing || _wrongPicks.Contains(option.Label))"
                    @onclick="() => Pick(option)">
                @option.Label
            </button>
        }
    </div>

    @if (_feedbackText is not null)
    {
        <div class="lese-feedback @(_solved ? "lese-feedback-richtig" : "lese-feedback-falsch")">@_feedbackText</div>
    }

    <div class="lese-fortschritt">
        <span>Richtig: @_correctCount</span>
        <span>Fehler: @_wrongCount</span>
    </div>
</div>
