@using Kidz2Learn.Model.Lesen
@using MudBlazor
<div class="leseturbo-container">
    @switch (_phase)
    {
        case Phase.Start:
            <div class="leseturbo-titel">🐆 Lese-Turbo!</div>
            <div class="leseturbo-text">
                @_sekunden Sekunden: Ist das ein echtes Wort oder ein Quatschwort? So schnell du kannst!
            </div>
            @* Keyboard only (hidden in MainLayout's touch layout): the arrow block with the two keys
               that count, and a looping demo - a real word answered with ←, a nonsense word with →. *@
            <div class="leseturbo-tastatur" aria-hidden="true">
                <div class="leseturbo-demo-wort">
                    <span class="leseturbo-demo-echt">Nase</span>
                    <span class="leseturbo-demo-quatsch">Pisnel</span>
                </div>
                <div class="leseturbo-pfeile">
                    <span class="leseturbo-kappe leseturbo-kappe-aus leseturbo-kappe-oben">↑</span>
                    <span class="leseturbo-kappe leseturbo-kappe-echt">←</span>
                    <span class="leseturbo-kappe leseturbo-kappe-aus leseturbo-kappe-unten">↓</span>
                    <span class="leseturbo-kappe leseturbo-kappe-quatsch">→</span>
                </div>
                <div class="leseturbo-legende">
                    <span class="leseturbo-legende-echt"><span class="leseturbo-taste">←</span> ✔ Echtes Wort</span>
                    <span class="leseturbo-legende-quatsch">✘ Quatschwort <span class="leseturbo-taste">→</span></span>
                </div>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.RocketLaunch" OnClick="Start">Los!</MudButton>
            break;

        case Phase.Laeuft:
            <MudProgressLinear Value="@RestProzent" Color="Color.Warning" Size="Size.Large" Rounded="true"
                               Class="leseturbo-zeit" />
            <div class="leseturbo-feld" tabindex="0" @ref="_feldRef" @onkeydown="Taste">
                <div @key="_wortCount" class="leseturbo-wort @_blitz">@_wort.Text</div>
                <div class="leseturbo-knoepfe">
                    <button class="leseturbo-knopf leseturbo-echt" @onclick="() => Antwort(true)">
<span class="leseturbo-taste">←</span> ✔ Echtes Wort
                    </button>
                    <button class="leseturbo-knopf leseturbo-quatsch" @onclick="() => Antwort(false)">
                        ✘ Quatschwort <span class="leseturbo-taste">→</span>
                    </button>
                </div>
            </div>
            break;

        case Phase.Ende:
            @if (LeseTurbo.Geschafft(_richtig, _falsch))
            {
                <div class="leseturbo-titel">Geschafft!</div>
                <div class="leseturbo-text">@_richtig richtig, @_falsch falsch</div>
            }
            else
            {
                <div class="leseturbo-titel">Knapp daneben!</div>
                <div class="leseturbo-text">@_richtig richtig, @_falsch falsch</div>
                <div class="leseturbo-text">
                    @(_richtig + _falsch < LeseTurbo.MindestWoerter
                        ? $"Schaffst du {LeseTurbo.MindestWoerter} Wörter? Dann zählt es."
                        : "3 von 4 richtig, dann zählt es.")
                </div>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="Weiter">Weiter</MudButton>
            break;
    }
</div>
