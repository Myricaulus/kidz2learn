@using System.Globalization
@inject IJSRuntime JS

@* TEMPORARY gate: a full-screen overlay above everything (splash included) until 10 rounds of
   "sort 4 words alphabetically" are solved today. One wrong check gets a single "Falsch, letzter
   Versuch" with no hints; a second wrong check takes one solved round away and starts a new
   round. Progress is per day in localStorage. Remove this component and its line in
   MainLayout.razor to take it out again. *@

@if (_loaded && _solved < Goal)
{
    <div class="wsg-root">
        <h1 class="wsg-title">Sortiere die Wörter nach dem ABC</h1>
        <div class="wsg-progress">@_solved / @Goal</div>

        <div class="wsg-list">
            @for (var i = 0; i < _words.Count; i++)
            {
                var index = i;
                <div class="wsg-slot"
                     @ondragstart="() => _dragIndex = index"
                     @ondragover:preventDefault="true"
                     @ondrop="() => Drop(index)">
                    @* setData in a plain attribute: Firefox only starts a drag when data is set. *@
                    <div class="wsg-word @(_selected == index ? "wsg-selected" : "")"
                         draggable="true"
                         ondragstart="event.dataTransfer.setData('text/plain', '');"
                         @onclick="() => Tap(index)">
                        @_words[index]
                    </div>
                </div>
            }
        </div>

        <button class="wsg-check" @onclick="Check">Prüfen</button>
        <div class="wsg-message">@_message</div>
    </div>
}

<style>
    .wsg-root {
        position: fixed; inset: 0; z-index: 3000;
        background: #1b1f3a; color: white;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 1.2em; font-family: sans-serif; user-select: none;
    }
    .wsg-title { font-size: 2em; margin: 0; text-align: center; }
    .wsg-progress { font-size: 1.6em; opacity: 0.8; }
    .wsg-list { display: flex; flex-direction: column; gap: 0.6em; min-width: 16em; }
    .wsg-slot { border-radius: 12px; }
    .wsg-word {
        background: #f5f5f5; color: #1b1f3a; font-size: 2.2em; font-weight: bold;
        padding: 0.35em 1em; border-radius: 12px; text-align: center; cursor: grab;
        border: 4px solid transparent;
    }
    .wsg-selected { border-color: #ffca28; }
    .wsg-check {
        font-size: 1.6em; padding: 0.4em 1.6em; border: none; border-radius: 12px;
        background: #43a047; color: white; cursor: pointer;
    }
    .wsg-message { font-size: 1.8em; min-height: 1.4em; color: #ffca28; }
</style>

@code {
    private const int Goal = 10;
    private const int WordsPerRound = 4;
    private static readonly CompareInfo German = CultureInfo.GetCultureInfo("de-DE").CompareInfo;

    private static readonly string[] Pool = WordMeta.Data.Keys
        .Where(w => w.Length > 1 && w.All(char.IsLetter) && !"ÄÖÜäöü".Contains(w[0]))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private readonly Random _rng = new();
    private List<string> _words = new();
    private bool _loaded;
    private int _solved;
    private bool _lastTry;
    private int? _dragIndex;
    private int? _selected;
    private string _message = "";

    private string StorageKey => $"k4l_wortsortieren_{DateTime.Now:yyyy-MM-dd}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            _solved = int.TryParse(stored, out var n) ? n : 0;
        }
        catch
        {
            _solved = 0;
        }
        NewRound();
        _loaded = true;
        StateHasChanged();
    }

    private void NewRound()
    {
        // Distinct first letters, so every round is decided by the first letter alone.
        var picked = new List<string>();
        foreach (var w in Pool.OrderBy(_ => _rng.Next()))
        {
            if (picked.Any(p => char.ToUpperInvariant(p[0]) == char.ToUpperInvariant(w[0]))) continue;
            picked.Add(w);
            if (picked.Count == WordsPerRound) break;
        }
        do
        {
            _words = picked.OrderBy(_ => _rng.Next()).ToList();
        } while (IsSorted());
        _lastTry = false;
        _selected = null;
    }

    private bool IsSorted() =>
        _words.Zip(_words.Skip(1)).All(p => German.Compare(p.First, p.Second, CompareOptions.IgnoreCase) <= 0);

    private void Drop(int target)
    {
        if (_dragIndex is not { } from || from == target) return;
        var word = _words[from];
        _words.RemoveAt(from);
        _words.Insert(target, word);
        _dragIndex = null;
        _selected = null;
    }

    private void Tap(int index)
    {
        if (_selected is not { } first)
        {
            _selected = index;
            return;
        }
        (_words[first], _words[index]) = (_words[index], _words[first]);
        _selected = null;
    }

    private async Task Check()
    {
        if (IsSorted())
        {
            _solved++;
            _message = _solved >= Goal ? "" : "Richtig!";
            await SaveAsync();
            NewRound();
            return;
        }
        if (!_lastTry)
        {
            _lastTry = true;
            _message = "Falsch, letzter Versuch";
            return;
        }
        _solved = Math.Max(0, _solved - 1);
        _message = "Falsch, einer abgezogen";
        await SaveAsync();
        NewRound();
    }

    private async Task SaveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, _solved.ToString());
        }
        catch
        {
            // Progress then only lives until the next reload.
        }
    }
}
