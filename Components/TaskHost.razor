@using Kidz2Learn.Model
@using Kidz2Learn.Model.Tasks
@using Kidz2Learn.Services
@using Tavenem.Blazor.IndexedDB

@if (_chosen is not null && _viewType is not null)
{
    <DynamicComponent Type="_viewType" Parameters="_parameters" />
}

@code {
    // Filters candidates to these skills (see AdaptiveTaskGenerator.ChooseAnyAsync); null means
    // "everything, across every domain" - see TASK_PRESENTATION_REDESIGN.md, Baustein 4/5.
    [Parameter] public IReadOnlyCollection<string>? Skills { get; set; }

    [Inject(Key = "AufgabenDB")] private IndexedDb AufgabenDb { get; set; } = null!;
    [Inject] private HudStateService Hud { get; set; } = null!;

    private readonly Random _rng = new();
    private IChosenTask? _chosen;
    private Type? _viewType;
    private IDictionary<string, object>? _parameters;

    protected override async Task OnInitializedAsync()
    {
        // Belongs here, not in a view's OnInitializedAsync: TaskHost is the one component that
        // stays a single instance for the whole page visit. Views come and go - DynamicComponent
        // recreates the component whenever _viewType changes (e.g. Bestenmix/Deutsch-Mix switching
        // between "silben-multiple-choice" and "arith-numpad") - so a reset in a view's own
        // OnInitializedAsync would refire on every such switch, wiping the combo mid-session. Found
        // during manual testing, see TASK_PRESENTATION_REDESIGN.md.
        Hud.ResetAll();
        await LoadNext();
    }

    private async Task LoadNext()
    {
        var store = new SkillMasteryStore(AufgabenDb);
        var generator = new AdaptiveTaskGenerator(store, _rng);
        _chosen = await generator.ChooseAnyAsync(Skills);
        _viewType = TaskPresentationRegistry.Resolve(_chosen.View);
        _parameters = new Dictionary<string, object>
        {
            [nameof(ITaskView.ChosenTask)] = _chosen,
            [nameof(ITaskView.OnNext)] = EventCallback.Factory.Create(this, LoadNext)
        };
    }
}
