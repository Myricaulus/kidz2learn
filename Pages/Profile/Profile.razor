@page "/profile"
@using Kidz2Learn.Model
@using Kidz2Learn.Shared.Extensions
@using MudBlazor
@using Tavenem.Blazor.IndexedDB

<MudPaper Class="p-4 mt-4">
    <MudText Typo="Typo.h5">Skill Profil</MudText>
    <MudTable Items="_skillsWithState" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Skill</MudTh>
            <MudTh>Domain</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Difficulty</MudTh>
            <MudTh>Attempts</MudTh>
            <MudTh>Success</MudTh>
            <MudTh>Mastery</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Definition.DisplayName</MudTd>
            <MudTd>@context.Definition.Domain.FirstCharToUpper()</MudTd>
            <MudTd>@context.Definition.Category?.FirstCharToUpper()</MudTd>
            <MudTd>@context.Definition.Difficulty</MudTd>
            <MudTd>@(context.State.Attempts)</MudTd>
            <MudTd>@(context.State.Success)</MudTd>
            <MudTd>@(context.State.Mastery.ToString("P0"))</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    [Inject(Key = "AufgabenDB")] private IndexedDb AufgabenDb { get; set; } = null!;

    private IEnumerable<SkillView>? _skillsWithState;

    protected override async Task OnInitializedAsync()
    {
        var store = new SkillMasteryStore(AufgabenDb);
        // Alle Skills in SkillRegistry einbeziehen
        _skillsWithState = (await store.GetSkillViewEnumerableAsync())
            .OrderBy(s => s.Definition.Domain)
            .ThenBy(s => s.Definition.Difficulty);
    }

}
