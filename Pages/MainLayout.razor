    private void StartApp()
    {
        // Synchronous JS call (no async hop) so the browser ties its audio-autoplay permission
        // directly to this click - the real syllable audio only plays later, after an
        // IndexedDB round trip, which is too far removed from the gesture for some browsers.
        ((IJSInProcessRuntime)Js).InvokeVoid("k4l_primeAudioPlayer", "audioPlayer");
        ((IJSInProcessRuntime)Js).InvokeVoid("k4l_primeAudioPlayer", "affirmationPlayer");
        ((IJSInProcessRuntime)Js).InvokeVoid("k4l_primeAudioContext");
        _showWelcome = false;
    }

    // Koop mode stays on until the app is reloaded, like the splash screen itself.
    private void StartKoop()
    {
        PlayMode.Koop = true;
        StartApp();
    }

    private float _points;

    private bool _skipSplash;

    // Touch layout: chosen once at startup from the device's primary pointer, ?layout=touch|desktop overrides it.
    private bool _touch;
    private bool _touchMenuOpen;
    private bool _touchLogOpen;
    private bool _migrationRunning;

    // Once true, stays true for the rest of the session - the YouTube reward doesn't
    // re-lock if the bonus decays back down after being earned.
    private bool _youtubeUnlocked;
    private bool _youtubePulseActive;
    private DateTime _sessionStart;
    private Timer? _attentionCheckTimer;
    private Timer? _pulseTimer;
    private readonly Random _pulseRng = new();

    protected override async Task OnInitializedAsync()
    {
        Score.OnScoreChanged += HandleScoreChanged;
        Audio.OnChange += HandleAudioChanged;

        _sessionStart = DateTime.UtcNow;
        _attentionCheckTimer = new Timer(_ => CheckAttentionEligibility(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));

        // Silbenhammer's word catalog is compile-time data (SilbenHammerWords.g.cs) - touching
        // .Index here builds its syllable lookup once, alongside the splash screen/IndexedDB
        // migration below, so it's already warm by the time "Starte App" is clicked instead of on
        // first navigation to the mode.
        _ = SilbenHammerWords.Index;

        // Splashscreen Query prüfen
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("skipSplash", out var value))
        {
            _skipSplash = value.ToString().ToLower() == "true";
        }

        // Synchronous, so the very first render already uses the right layout.
        query.TryGetValue("layout", out var layout);
        _touch = layout.ToString() switch
        {
            "touch" => true,
            "desktop" => false,
            _ => ((IJSInProcessRuntime)Js).Invoke<bool>("k4l_isTouchDevice")
        };
        Navigation.LocationChanged += CloseTouchMenu;

        // Local dev runs (dotnet run/Rider, environment "Development") take their endpoint from the
        // gitignored wwwroot/appsettings.Development.json, so they always log without ?telemetrie=.
        query.TryGetValue("telemetrie", out var telemetrie);
        var telemetrieValue = telemetrie.ToString();
        if (string.IsNullOrWhiteSpace(telemetrieValue))
            telemetrieValue = Configuration["Telemetrie"];
        await Telemetry.InitAsync(telemetrieValue);
        query.TryGetValue("spiele", out var spiele);
        Spielzeit.Init(spiele.ToString());
        Spielzeit.OnChange += HandleSpielzeitChanged;
        await Audio.InitAsync();

        // IndexedDB Migration
        var migrationHelper = new SkillMigrationHelper(AufgabenDb);
        await migrationHelper.EnsureSchemaAsync();

        // Migration abgeschlossen → Button freigeben
        _migrationRunning = false;
        StateHasChanged(); // UI aktualisieren
    }

    private void HandleSpielzeitChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleAudioChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void CloseTouchMenu(object? sender, LocationChangedEventArgs e)
    {
        if (!_touchMenuOpen)
            return;
        _touchMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer()
    {
        _toggleMenuDrawer = !_toggleMenuDrawer;
    }

    private void HandleScoreChanged(float score, float bonus)
    {
        if (bonus < 2)
            _biberState = "angry";
        else if (bonus > 50)
            _biberState = "normal"; // chainsaw
        else
            _biberState = "normal";
        _useTransition = Score.TotalScore < _points;
        _points = Score.TotalScore;

        if (_points >= 100)
            _youtubeUnlocked = true;

        StateHasChanged();
    }

    private async Task OnYoutubeClick()
    {
        if (!_youtubeUnlocked)
            return;

        // On opted-in devices a failed upload stops here, so the console (which says why) can
        // still be inspected before the page is gone. Other devices never get the dialog.
        if (!await Telemetry.FlushAsync() && !await Js.InvokeAsync<bool>("confirm", "Wirklich zu YouTube wechseln?"))
            return;

        Navigation.NavigateTo("https://youtube.com", true);
    }

    private void CheckAttentionEligibility()
    {
        if (DateTime.UtcNow - _sessionStart < TimeSpan.FromMinutes(5))
            return;

        _attentionCheckTimer?.Dispose();
        _attentionCheckTimer = null;
        ScheduleNextPulse();
    }

    // Occasional, non-distracting glow to draw attention to the YouTube reward once it's
    // been available a while - grey/brightness flash while still locked, a brief color
    // overshoot once unlocked. Keeps running after unlock too, as a nudge to actually click it.
    private void ScheduleNextPulse()
    {
        var delay = TimeSpan.FromSeconds(_pulseRng.Next(20, 45));
        _pulseTimer = new Timer(_ => StartPulse(), null, delay, Timeout.InfiniteTimeSpan);
    }

    private void StartPulse()
    {
        _youtubePulseActive = true;
        InvokeAsync(StateHasChanged);
        _pulseTimer = new Timer(_ => EndPulse(), null, TimeSpan.FromMilliseconds(1600), Timeout.InfiniteTimeSpan);
    }

    private void EndPulse()
    {
        _youtubePulseActive = false;
        InvokeAsync(StateHasChanged);
        ScheduleNextPulse();
    }

    public void Dispose()
    {
        Score.OnScoreChanged -= HandleScoreChanged;
        Audio.OnChange -= HandleAudioChanged;
        Spielzeit.OnChange -= HandleSpielzeitChanged;
        Navigation.LocationChanged -= CloseTouchMenu;
        _attentionCheckTimer?.Dispose();
        _pulseTimer?.Dispose();
    }

}
