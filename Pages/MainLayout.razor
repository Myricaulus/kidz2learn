@using System.Globalization
@using Kidz2Learn.Components
@using Kidz2Learn.Model
@using Kidz2Learn.Pages.HUD
@using Kidz2Learn.Services
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.WebUtilities
@using MudBlazor
@using Tavenem.Blazor.IndexedDB
@inherits LayoutComponentBase
@implements IDisposable
@* Required *@
<MudThemeProvider/>
<MudPopoverProvider/>

@* Needed for dialogs *@
<MudDialogProvider/>

@* Needed for snackbars *@
<MudSnackbarProvider/>

@* Persistently-mounted, shared audio element for syllable/word playback (SilbenChallenge,
   GraphemChallenge). Lives here - outside the splash/main-layout @if branches - so it's the
   same DOM node primed synchronously in StartApp() and later reused via k4l_playAudioFile,
   regardless of _showWelcome. Kept it out of the challenge pages themselves so priming on the
   "Starte App" click and later playback always target the identical element. *@
<audio id="audioPlayer"></audio>

@* Same idea, separate element, for AffirmationService's success/failure sounds - kept apart
   from #audioPlayer so an affirmation can't abort (or get aborted by) word/syllable playback,
   since a single <audio> element can only play one source at a time. *@
<audio id="affirmationPlayer"></audio>

@if (_showWelcome && !_skipSplash)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%;
                background-color: rgba(0, 0, 0, 0.8); color: white; 
                display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="text-align: center;">
            <h1>Willkommen zu meinem epischen Übungsspiel zum Rechnen und Hören.</h1>
            <p>Dazu gibts noch ein wenig C64 Sound Nostalgie.</p>
            <p>Das hier ist noch eine Baustelle. Nicht alles ist Fertig. Aber es ist benutzbar. </p>
            <p>Fehlende Features: </p>
            <ul>
                <li>Automatisches Schwerer werden der Aufgaben anhand des Kompetenzniveaus.</li>
                <li>Punkte reduzierung für gemeisterte Aufgaben.</li>
                <li>Reduktion der gemeisterten Aufgaben.</li>
                <li>Weitere Rechentypen: Subtraktion, Multiplikation, Division</li>
                <li>Time Attack: Timer läuft runter, je mehr Aufgaben in der Zeit geschafft wurden, desto mehr Punkte.
                </li>
                <li>Schwierigkeitsregler für mutige.</li>
                <li>Extra Button zum starten ohne Musik.</li>
                <li>Mehr lieder</li>
            </ul>
            @* Same button twice, told apart only by the icon: one person plays alone, two play Koop. *@
            @foreach (var (icon, start, label) in new[]
                      {
                          (Icons.Material.Filled.Person, (Action)StartApp, "Allein spielen"),
                          (Icons.Material.Filled.People, StartKoop, "Zusammen spielen (Koop)")
                      })
            {
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Size="Size.Large"
                           Disabled="_migrationRunning"
                           Style="margin: 0 0.5em; min-width: 6em; min-height: 4em;"
                           aria-label="@label"
                           OnClick="start">
                    @if (_migrationRunning)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                    }
                    else
                    {
                        <MudIcon Icon="@icon" Size="Size.Large"/>
                    }
                </MudButton>
            }
            <p style="margin-top: 1.5em; font-size: 0.85em; opacity: 0.6;">@AppVersion.Text</p>
        </div>
    </div>
}
else if (_touch)
{
    @* Touch devices: the task gets the whole screen; menu and log are drawers that slide over it. *@
    <MudLayout Class="touch-layout">
        <MudAppBar Elevation="4" Dense="true" Class="appbar-with-biber touch-bar">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="() => _touchMenuOpen = !_touchMenuOpen"/>
            @AppBarContent
            <MudIconButton Icon="@Icons.Material.Filled.ListAlt" Color="Color.Inherit" Edge="Edge.End"
                           OnClick="() => _touchLogOpen = !_touchLogOpen"/>
        </MudAppBar>

        <MudDrawer @bind-Open="@_touchMenuOpen" Variant="DrawerVariant.Temporary" Anchor="Anchor.Left">
            @NavMenu
            <SidPlayerWidget/>
        </MudDrawer>

        <MudDrawer @bind-Open="@_touchLogOpen" Variant="DrawerVariant.Temporary" Anchor="Anchor.Right" Width="320px">
            <MudStack Breakpoint="Breakpoint.None" Class="pa-2">
                <LiveLogger/>
            </MudStack>
        </MudDrawer>

        <MudMainContent>
            <div class="touch-root">
                <div class="page-content">
                    @Body
                </div>
                <div class="touch-hud">
                    <HUDContainer ShowGithub="false"/>
                </div>
            </div>
        </MudMainContent>
    </MudLayout>
}
else
{
    <MudLayout>
        <MudAppBar Elevation="4" Class="appbar-with-biber">
            <MudIconButton Icon="@BrainIcon" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer"/>
            @AppBarContent
        </MudAppBar>

        <MudDrawer @bind-Open="@_toggleMenuDrawer" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Mini">
            @NavMenu
            <SidPlayerWidget/>
        </MudDrawer>
        <MudMainContent>
            <div class="layout-root">
                <div class="page-content">
                    @Body
                </div>

                <div class="hud-area">
                    <HUDContainer/>
                </div>
            </div>
        </MudMainContent>

        <MudDrawer Anchor="Anchor.Right" @bind-Open="@_toggleLogDrawer" ClipMode="DrawerClipMode.Always"
                   Variant="DrawerVariant.Responsive">
            <MudStack Breakpoint="Breakpoint.None">
                <LiveLogger/>
            </MudStack>
        </MudDrawer>

    </MudLayout>
}

@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@code {
    [Inject] public ScoreService Score { get; set; } = null!;
    [Inject(Key = "AufgabenDB")] private IndexedDb AufgabenDb { get; set; } = null!;
    [Inject] private IJSRuntime Js { get; set; } = null!;
    [Inject] private TelemetryService Telemetry { get; set; } = null!;
    [Inject] private AudioStatusService Audio { get; set; } = null!;
    [Inject] private SpielzeitService Spielzeit { get; set; } = null!;

    public delegate void UpdatePointsHook(int delta);

    // Shared by the desktop and the touch layout.
    private RenderFragment AppBarContent => @<text>
            @if (PlayMode.Koop)
            {
                <MudChip T="string" Color="Color.Secondary" Icon="@Icons.Material.Filled.People">Koop</MudChip>
            }
            @if (!Audio.Available)
            {
                <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.VolumeOff">Kein Ton</MudChip>
            }
            <div class="progress-container">
                <MudProgressLinear Value="@_points" Max="100" Size="Size.Large" Rounded="true"
                                   style="height: 20px; background-color: #5d3e33;"/>

                <!-- Biber-Overlay -->
                <div class="beaver @_biberState @(_useTransition ? "smooth-decay" : "")"
                     style="left:@_points.ToString("F1", CultureInfo.InvariantCulture)%;"></div>
            </div>
            <div class="youtube-wrap @(_youtubeUnlocked ? "unlocked" : "") @(_youtubePulseActive ? "attention-pulse" : "")"
                 @onclick="OnYoutubeClick">
                <MudImage Src="youtube.png" Alt="Youtube" Class="youtube-img"/>
                <svg class="youtube-lock" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <g class="lock-shackle" fill="none" stroke-linecap="round">
                        <path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="#5a3d00" stroke-width="3.4"/>
                        <path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="#ffd34d" stroke-width="1.8"/>
                    </g>
                    <rect x="4.5" y="10.5" width="15" height="11" rx="2.5" fill="#f5b301" stroke="#5a3d00" stroke-width="1.2"/>
                    <circle cx="12" cy="15" r="1.6" fill="#5a3d00"/>
                    <rect x="11.3" y="15.5" width="1.4" height="3.2" rx="0.6" fill="#5a3d00"/>
                </svg>
            </div>
            @if (Spielzeit.Spiele.Count > 0)
            {
                <div class="spielzeit" title="Voller Balken + eine 💣 = 10 Minuten Spielzeit">
                    <div class="spielzeit-balken">
                        <div class="spielzeit-fuellung"
                             style="width:@((100f * Spielzeit.Punkte / Spielzeit.Ziel).ToString("F1", CultureInfo.InvariantCulture))%"></div>
                        <span class="spielzeit-mauer @(Spielzeit.MauerWeg ? "weg" : "") @(Spielzeit.BrauchtBombe ? "wartet" : "")">
                            @(Spielzeit.MauerWeg ? "💥" : "🧱")
                        </span>
                    </div>
                    <span class="spielzeit-minuten">
                        🎮<input class="minuten-feld" inputmode="numeric" value="@Spielzeit.Minuten"
                                 style="width:@((Spielzeit.Minuten.ToString().Length + 0.5).ToString(CultureInfo.InvariantCulture))ch"
                                 @onchange="OnMinutenGeaendert" aria-label="Spielminuten"/>min
                    </span>
                    @foreach (var spiel in Spielzeit.Spiele)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                   Disabled="@(Spielzeit.Minuten <= 0)" OnClick="@(() => Spielzeit.AuszahlenAsync(spiel))">
                            @SpielName(spiel)
                        </MudButton>
                    }
                </div>
            }
    </text>;

    private static string SpielName(string spiel) => spiel switch
    {
        "steam" => "Steam",
        "heroic" => "Heroic",
        "prism" => "Minecraft",
        _ => spiel
    };

    // Typing a number into the minutes field just takes it - see SpielzeitService.
    private void OnMinutenGeaendert(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var minuten))
            Spielzeit.Minuten = minuten;
        StateHasChanged();
    }

    private RenderFragment NavMenu => @<text>
            <MudNavMenu>
                <MudNavLink Href="ArithmeticChallenge" Disabled Icon="@Icons.Material.Filled.Add">Addition</MudNavLink>
                <MudNavLink Href="ArithmeticTurbo" Disabled Icon="@Icons.Material.Filled.Rocket">Turbo Rechnen</MudNavLink>
                <MudNavLink Href="mathe-mix" Disabled Icon="@Icons.Material.Filled.Calculate">Mathe-Mix</MudNavLink>
                <!--MudNavLink Href="page1" Icon="@Icons.Material.Filled.Star">Page 1</MudNavLink-->
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ManageSearch">Lesedetektiv</MudNavLink>
                <MudNavLink Href="textaufgaben" Icon="@Icons.Material.Filled.AutoStories">Textaufgaben</MudNavLink>
                <MudNavLink Href="/silben" Match="NavLinkMatch.All" Disabled Icon="@Icons.Material.Filled.Abc">Mi Im Ma</MudNavLink>
                <MudNavLink Href="/graphem" Match="NavLinkMatch.All" Disabled Icon="@Icons.Material.Filled.SwitchAccessShortcut">W oder F</MudNavLink>
                <MudNavLink Href="deutsch-mix" Disabled Icon="@Icons.Material.Filled.MenuBook">Deutsch-Mix</MudNavLink>
                <MudNavLink Href="Silbentrainer" Disabled Icon="@Icons.Material.Filled.MicExternalOn">Trainer</MudNavLink>
                <MudNavLink Href="silben-hammer" Icon="@Icons.Material.Filled.Construction">Silbenhammer</MudNavLink>
                <MudNavLink Href="bestenmix" Disabled Icon="@Icons.Material.Filled.Shuffle">Bestenmix</MudNavLink>
                <MudNavLink Href="Profile" Icon="@Icons.Material.Filled.Person">Profil</MudNavLink>
                @if (_touch)
                {
                    <MudNavLink Href="https://github.com/Myricaulus/kidz2learn" Target="_blank" Icon="@Icons.Custom.Brands.GitHub">GitHub</MudNavLink>
                }
            </MudNavMenu>
    </text>;

    bool _showWelcome = true;
    bool _toggleMenuDrawer = true;
    bool _toggleLogDrawer = true;
    string _biberState = "angry";
    bool _useTransition;
